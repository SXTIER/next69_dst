.next-start.err.log
.next-start.log
live-poll-err.log
live-poll.log

# Playwright CLI snapshots
.playwright-cli/

# test output
test-results/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
